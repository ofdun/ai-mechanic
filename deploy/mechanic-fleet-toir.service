[Unit]
Description=Hackathon fleet maintenance mock
After=network.target
Before=mechanic-fleet.service

[Service]
User=mechanic-demo
WorkingDirectory=/opt/ai-mechanic/fleet/mocks
ExecStart=/opt/ai-mechanic/venv/bin/python -m uvicorn mock_toir.app:app --host 127.0.0.1 --port 8102 --no-access-log
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
