[Unit]
Description=Digital mechanic synthetic diagnosis and maintenance services
After=network.target
Before=mechanic-demo.service

[Service]
User=mechanic-demo
WorkingDirectory=/opt/ai-mechanic/current
ExecStart=/opt/ai-mechanic/venv/bin/python -m uvicorn demo.upstream:app --host 127.0.0.1 --port 8001 --no-access-log
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
