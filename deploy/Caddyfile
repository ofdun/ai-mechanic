{
	default_sni {$STAND_HOST}
}

https://{$STAND_HOST} {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	# Install manifest and icons stay public: the phone may fetch them without the stand password.
	@private not path /manifest.json /icons/*
	basic_auth @private {
		{$STAND_USER} {$STAND_PASSWORD_HASH}
	}
	header >Cache-Control "private, no-store"
	reverse_proxy web:{$WEB_LISTEN_PORT} {
		header_up -Authorization
	}
}
