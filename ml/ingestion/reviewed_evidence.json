  "entries": [
    {
      "fault_code": "F02",
      "claims": [
        {
          "kind": "risk",
          "text": "Если горит лампа аварийного давления масла, работа двигателя грозит повреждением подшипников и привода газораспределения. Руководство отдельно допускает загорание на минимальных оборотах холостого хода и при резком торможении. Сверьте условия.",
          "evidence_ids": [
            "zmz-40904-40905_rk_2025:91"
          ]
        }
      ]
    },
    {
      "fault_code": "F04",
      "claims": [
        {
          "kind": "risk",
          "text": "Если проскальзывает ремень вентилятора, двигатель может перегреваться.",
          "evidence_ids": [
            "zmz-5234_rk_2025:54"
          ]
        }
      ]
    },
    {
      "fault_code": "F04",
      "claims": [
        {
          "kind": "risk",
          "text": "При чрезмерном или недостаточном натяжении приводные ремни могут преждевременно выйти из строя.",
          "evidence_ids": [
            "yamz-236-operations-2010:28"
          ]
        }
      ]
    },
    {
      "fault_code": "F01",
      "claims": [
        {
          "kind": "operation",
          "text": "Проверить тепловые зазоры в приводе клапанов по порядку обслуживания этого двигателя.",
          "evidence_ids": [
            "yamz-236-operations-2010:25"
          ]
        }
      ]
    },
    {
      "fault_code": "F01",
      "claims": [
        {
          "kind": "operation",
          "text": "На холодном двигателе проверить щупом зазор между коромыслом и стержнем клапана в указанном для цилиндра положении.",
          "evidence_ids": [
            "zmz-5234_rk_2025:21"
          ]
        }
      ]
    },
    {
      "fault_code": "F02",
      "claims": [
        {
          "kind": "operation",
          "text": "Проверить уровень масла в картере двигателя.",
          "evidence_ids": [
            "yamz-236-operations-2010:23"
          ]
        }
      ]
    },
    {
      "fault_code": "F02",
      "claims": [
        {
          "kind": "operation",
          "text": "Проверить уровень масла в картере двигателя по указателю.",
          "evidence_ids": [
            "zmz-5234_rk_2025:28"
          ]
        }
      ]
    },
    {
      "fault_code": "F02",
      "claims": [
        {
          "kind": "operation",
          "text": "Проверить уровень масла в картере двигателя по указателю.",
          "evidence_ids": [
