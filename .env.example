FLEET_DIR=./data
MOCK_DIR=./data/mocks
COMPOSE_PROFILES=mocks
WEB_PORT=8080
# Public stand (Linux): enable both files and set HTTPS credentials.
# COMPOSE_FILE=compose.yaml:compose.stand.yaml
# STAND_HOST=203.0.113.10
# STAND_USER=mechanic
# Example only. Set your own password in .env before publishing the stand.
# STAND_PASSWORD='demo-password'
# Alternatively set STAND_PASSWORD_HASH to a single-quoted bcrypt hash.
# WEB_LISTEN_PORT=8080
# AGENT_URL=http://agent:8000
# SPEECH_URL=http://speech:8003
# WEB_AGENT_TIMEOUT=20m
DATA_DIR=./data
# VEHICLES_PATH=./data/vehicles.json
ARTIFACTS_DIR=./artifacts
# Base URLs, optionally with a path prefix. The client appends /diagnose and /tickets.
ML_API_URL=http://ml:8001
MAINTENANCE_API_URL=http://maintenance:8002
HTTP_TIMEOUT_SECONDS=20
MIN_DIAGNOSTIC_CONFIDENCE=0.70
REPEAT_ON_WARNING=true
# Noisy but confident record: continue after the mechanic's explicit confirmation.
CONFIRM_SIGNAL_WARNING=true
# Audit log: ARTIFACTS_DIR/agent-audit.sqlite3, kept apart from service logs; older records are removed.
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=90
DEFAULT_TICKET_URGENCY=medium
# TICKET_URGENCY_BY_FAULT={}
# MANUAL_MANIFEST_PATH=/etc/ai-mechanic/manifest.json
# REVIEWED_EVIDENCE_PATH=/etc/ai-mechanic/reviewed_evidence.json
# Local fleet profile: PLANNER_MODE=local, AGENT_ARCHITECTURE=baseline.
# Build page lookup and team BM25 indexes from the same PDFs.
WEB_RETRIEVAL_MODE=team
# RETRIEVAL_CONFIG_PATH=/app/configs/retrieval-web.yaml
PLANNER_MODE=local
# For the hosted generation profile, use a and enable external evidence with a configured LLM_API_KEY.
AGENT_ARCHITECTURE=baseline
ALLOW_EXTERNAL_EVIDENCE=false
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=z-ai/glm-5.3-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=45
# Retrieval на Cloudflare Workers AI: embedder cf:@cf/baai/bge-m3, reranker cf:@cf/baai/bge-reranker-base.
# Эмбеддинг корпуса и reranking отправляют текст руководств, нужен ALLOW_EXTERNAL_EVIDENCE=true.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Retrieval на OpenRouter: embedder or:baai/bge-m3, reranker or:cohere/rerank-5-pro (или другой из /rerank).
# Пустой ключ — берётся LLM_API_KEY, если LLM_BASE_URL указывает на OpenRouter. Нужен ALLOW_EXTERNAL_EVIDENCE=true.
OPENROUTER_API_KEY=
A_GENERATOR_MODEL=deepseek/deepseek-v4.1-flash
A_VERIFIER_MODEL=z-ai/glm-5.3-flash
B_QUERY_MODEL=z-ai/glm-5.3-flash
B_REASONER_MODEL=z-ai/glm-5.3
B_CRITIC_MODEL=deepseek/deepseek-v4.1-flash
B_REPAIR_MODEL=deepseek/deepseek-v4.1-flash
B_FINALIZER_MODEL=z-ai/glm-5.3-flash
